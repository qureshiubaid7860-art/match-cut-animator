# Optional second public article-search provider. GDELT DOC works without a key.
NEWSAPI_KEY=

# Application limits and rendering defaults
MATCHCUT_DATA_DIR=./data
MAX_UPLOAD_MB=24
MAX_UPLOAD_FILES=18
MAX_ARTICLES=36
MAX_PDF_PAGES=8
DEFAULT_DURATION=10
DEFAULT_FPS=30
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920

# Optional system FFmpeg path. If empty, use the bundled imageio-ffmpeg binary.
FFMPEG_BINARY=
